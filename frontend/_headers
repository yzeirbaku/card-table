  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://yzeir-cards.duckdns.org wss://yzeir-cards.duckdns.org http://localhost:8020 ws://localhost:8020; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

